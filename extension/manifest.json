{
  "manifest_version": 3,
  "name": "REWIND Recorder",
  "version": "0.4.0",
  "description": "Record interactions in an authorized browser tab, browse the history, and rewind to an earlier point.",
  "action": {
    "default_title": "REWIND Recorder",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:48292/*",
    "http://localhost:48292/*"
  ]
}

