{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "REWIND Desktop",
  "version": "0.3.0",
  "identifier": "com.rewind.desktop",
  "build": {
    "frontendDist": "../overlay"
  },
  "app": {
    "windows": [
      {
        "title": "REWIND Floating HUD",
        "width": 460,
        "height": 46,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
