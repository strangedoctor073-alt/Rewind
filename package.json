{
  "name": "rewind",
  "version": "5.2.0",
  "private": true,
  "description": "Local-first window-activity timeline, universal-undo hotkey and browser interaction recorder for Windows and Chromium.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strangedoctor073-alt/Rewind.git"
  },
  "bugs": {
    "url": "https://github.com/strangedoctor073-alt/Rewind/issues"
  },
  "homepage": "https://github.com/strangedoctor073-alt/Rewind#readme",
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [
    "undo",
    "time-machine",
    "electron",
    "windows",
    "session-replay",
    "chrome-extension",
    "local-first",
    "privacy"
  ],
  "type": "module",
  "bin": {
    "rewind": "./bin/rewind.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:daemon": "tsc -p tsconfig.daemon.build.json",
    "daemon": "npm run build:daemon && node dist-daemon/daemon/main.js",
    "build:extension": "tsc -b tsconfig.extension.json && vite build --config vite.extension.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop": "electron desktop/main.js",
    "cli": "node bin/rewind.js",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@xyflow/react": "^12.12.0",
    "better-sqlite3": "^13.0.3",
    "fflate": "^0.8.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "koffi": "^3.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  }
}
