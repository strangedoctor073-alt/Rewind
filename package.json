{
  "name": "rewind",
  "version": "0.2.0",
  "description": "A local-first interaction recorder and replay timeline for supported web surfaces.",
  "license": "MIT",
  "keywords": [
    "recording",
    "replay",
    "timeline",
    "react",
    "developer-tools"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:extension": "tsc -b tsconfig.extension.json && vite build --config vite.extension.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop": "electron desktop/main.js",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "koffi": "^3.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  }
}
